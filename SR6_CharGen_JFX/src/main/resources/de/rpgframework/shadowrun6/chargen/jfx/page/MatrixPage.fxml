<GridPane id="gridMatrix" hgap="20.0" vgap="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.rpgframework.shadowrun6.chargen.jfx.page.MatrixPageController">
   <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" percentWidth="25.0" />
      <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" percentWidth="25.0" />
      <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" percentWidth="25.0" />
      <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" percentWidth="25.0" />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
   </rowConstraints>
   <children>
      <GearSection fx:id="secDevices" />
      <SR6PersonaSection fx:id="secPersona" GridPane.columnIndex="1" GridPane.columnSpan="2" />
      <AccessoriesSection fx:id="secAccessories" GridPane.columnIndex="3" />
      <!--ActiveProgramsSection fx:id="secPrograms" GridPane.columnIndex="1" GridPane.rowIndex="1" /-->
      <SoftwareLibrarySection fx:id="secSoftware" GridPane.columnSpan="2" GridPane.rowIndex="1" />
      <CombatSection fx:id="secCombat" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="1" />
   </children>
   <styleClass>
      <String fx:value="charview-page" />
      <String fx:value="page-matrix" />
   </styleClass>
</GridPane>
