<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="info">
    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
             <PatternLayout   pattern="%5p [%c] (%F:%L) - %m%n" />
        </Console>
    </Appenders>
    <Loggers>
        <Root level="INFO" additivity="false">
            <appender-ref ref="console" />
        </Root>
        <Logger name="xml" level="warn" />
        <Logger name="prelle.jfx" level="warn" />
        <Logger name="rpgframework" level="INFO" />
        <Logger name="de.rpgframework.genericrpg.items" level="WARN" />
        <Logger name="de.rpgframework.shadowrun6.items" level="WARN" />
        <Logger name="de.rpgframework.shadowrun.proc.quality" level="WARN" />
        <Logger name="de.rpgframework.shadowrun6.chargen.gen.priority.attrib" level="TRACE"/>
    </Loggers>
</Configuration>