   <item id="ruhrmetall_hovawart" avail="3L" price="12000" type="DRONE_MINI" subtype="AIR">
      <vehicle han="3" acc="14" spdi="25" tspd="120" bod="1" arm="1" pil="3" sen="5" sea="0" />
      <modifications>
		<!-- According to current interpretation of Genesis, to achieve sensor rating 5 needs enhanced_sensors 5, which needs 5 slots, which the drone does not have, thus the mod is marked "included". Base sensor is 3 and enhanced_sensors is rating +2, needing two slots, one from electronics and one created from moving the 1 body and 1 powertrain to electronics.
		Thus all slots are used. To represent this capacity is reduced to zero for all 3 mod slots. -->

		<embed  type="GEAR" intoType="HOOK" intoRef="VEHICLE_ELECTRONICS" ref="enhanced_sensors" included="true" >
                <decision choice="c2d17c87-1cfe-4355-9877-a20fe09c170d" value="5"/>
                </embed>
		<valmod type="HOOK" ref="VEHICLE_ELECTRONICS" value="-1" />
		<valmod type="HOOK" ref="VEHICLE_CHASSIS" value="-1" />
		<valmod type="HOOK" ref="VEHICLE_POWERTRAIN" value="-1" />
      </modifications>
   </item>

