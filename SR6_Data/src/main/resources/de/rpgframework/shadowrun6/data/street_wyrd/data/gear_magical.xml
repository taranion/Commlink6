<!-- Preparations -->

<!-- Ideally the preparations would have 4 rates: Potency 4-8, Magic 4-8, Long lasting yes/no, number of charges. This could look like
	<item id="acid_on_demand" avail="6L" price="600" type="MAGICAL" subtype="PREPARATION" choice="POTENCY" choice="MAGIC" choice="DURATION" choice="CHARGES" choice="NAME" count="y"/>

	To avoid too many changes to code, preparations are setup following these guidelines:
	1) It is assumed that potency is equal to magic. This is used as the rating. Costs are 100 for potency plus 50 for magic. As rating starts at 4, costs are -600 (4x150)
	2) Diffence between duration in weeks and duration in months is handled by creating two items for each preparation, one with base one with extended duration.
	3) Charges are handled by making preparations countable. From Genesis view it makes no difference if someone has 2 times a preparation or one preparation with 2 charges

	choice="NAME" should allow the user to enter the purchase date, to be able to calculate active potency based on purchase potency and time, however does not work yet.

-->

<!-- Preparations with base duration (weeks) -->

	<item id="acid_on_demand" avail="6L" type="MAGICAL" subtype="ALCHEMICAL"  count="y">
		<choices>
			<choice uuid="c2d17c87-1cfe-4355-9877-a20fe09c170d" type="ITEM_ATTRIBUTE" ref="RATING" options="4,5,6,7,8" i18n="potency"/>
			<choice uuid="96afe3d6-adf9-4e78-829c-b25f2c7f6b76" type="ATTRIBUTE" ref="MAGIC" options="4,5,6,7,8"/>
			<choice uuid="96afe3d6-adf9-4e78-829c-b25f2c7f6b77" type="TEXT" ref="DATE" i18n="shelflife"/>
		</choices>
      <attrdef id="PRICE" value="600 + (($RATING-4)*100) + (($MAGIC-4)*50) "/>
      <alchemy spell="acid_stream" trigger="verbal" />
      <variant id="extended">
        <attrdef id="PRICE" value="(600 + ( ($RATING-4) *100) + ( ( $MAGIC-4)*50 ) ) *4 "/>
      </variant>
    </item>

