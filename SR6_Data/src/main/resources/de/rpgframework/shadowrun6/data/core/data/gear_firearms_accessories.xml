<items>
	<item id="laser_sight" avail="1" price="125" type="WEAPON_FIREARMS" subtype="ACCESSORY">
		<usage slot="TOP" />
		<usage slot="UNDER" />
		<modifications>
		    <valmod  type="ACTION_BONUS"  ref="change_device_mode" mode="WIRELESS" value="MINOR"/>
		</modifications>
		<mode id="laser_sight.active.offline">
		  <modifications>
		  	<valmod type="ITEM_ATTRIBUTE" ref="ATTACK_RATING" value="1,1,1,1,1" mode="!WIRELESS,!SMARTGUN" />
		  </modifications>
		</mode>
		<mode id="laser_sight.active.wireless">
		  <modifications>
		  	<valmod type="ITEM_ATTRIBUTE" ref="ATTACK_RATING" value="2,2,2,2,2" mode="WIRELESS,!SMARTGUN" />
		  </modifications>
		</mode>
	</item>
	<item id="smartgun_system" avail="2L" price="200" type="WEAPON_FIREARMS" subtype="ACCESSORY">
		<usage slot="TOP" />
		<usage slot="UNDER" />
		<mode id="SMARTGUN">
			<requires>
		    	<datareq apply="ACTIVE_GEAR" type="GEAR" ref="smartlink" />
		  	</requires>
			<modifications>
		  		<valmod type="ITEM_ATTRIBUTE" ref="ATTACK_RATING" value="2,2,2,2,2" />
		  		<valmod type="ITEM_ATTRIBUTE" ref="DICEPOOL"           mode="WIRELESS" value="1" />
		      <valmod  type="ACTION_BONUS" ref="reload"             mode="WIRELESS" value="MINOR"/>
		      <valmod  type="ACTION_BONUS" ref="change_device_mode" mode="WIRELESS" value="MINOR"/>
		  	</modifications>
		</mode>
	</item>
