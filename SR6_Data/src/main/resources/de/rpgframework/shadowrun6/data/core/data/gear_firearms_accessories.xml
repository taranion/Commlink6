<items>
   <item id="ares_light_fire_75" avail="3L" cost="400" type="WEAPON_FIREARMS" subtype="PISTOLS_LIGHT">
      <usage slot="CARRIED"/>
	  <usage slot="VEHICLE_MOUNT" volume="1" />
  	  <useas slot="CYBER_WEAPON" />
      <modifications>
         <itemmod type="SLOT" ref="TOP"/>
         <itemmod type="SLOT" ref="BARREL"/>
         <itemmod type="ITEM_ENHANCEMENT" ref="smartgun_system"/>
      </modifications>
      <accessories>
        <accessory item="laser_sight" slot="TOP" included="true"/>
      </accessories>
      <weapon dmg="2P" attack="10,7,6,," mode="SA" ammo="16(c)" skill="firearms" spec="firearms/pistols"/>
   </item>
	<item id="laser_sight" avail="1" cost="125" type="WEAPON_FIREARMS" subtype="ACCESSORY">
		<usage slot="TOP" />
		<usage slot="UNDER" />
		<modifications>
		    <itemmod type="ACTION_ITEM"  ref="toggle_laser_sight" />
		    <valmod  type="ACTION_COST"  ref="toggle_laser_sight" mode="WIRELESS" value="MINOR_ZERO"/>
		</modifications>
		<mode id="mode.active">
		  <modifications>
		  	<valmod type="ITEMATTRIBUTE" ref="ATTACK_RATING" value="1,1,1,1,1" mode="OFFLINE,!SMARTGUN" />
		  </modifications>
		</mode>
		<mode id="mode.active_wireless">
		  <modifications>
		  	<valmod type="ITEMATTRIBUTE" ref="ATTACK_RATING" value="2,2,2,2,2" mode="WIRELESS,!SMARTGUN" />
		  </modifications>
		</mode>
	</item>
	<item id="smartgun_system" avail="2L" cost="200" type="WEAPON_FIREARMS" subtype="ACCESSORY">
		<usage slot="TOP" />
		<usage slot="UNDER" />
		<modifications>
		    <valmod  type="ACTION_COST"  ref="reload" mode="WIRELESS" value="MINOR_ZERO"/>
		    <valmod  type="ACTION_COST"  ref="change_device_mode" mode="WIRELESS" value="MINOR_ZERO"/>
		</modifications>
		<mode id="SMARTGUN">
			<requires>
		    	<datareq apply="ACTIVE_GEAR" type="GEAR" ref="smartlink" />
		  	</requires>
			<modifications>
		  		<valmod type="ITEMATTRIBUTE" ref="ATTACK_RATING" value="2,2,2,2,2" />
		  		<valmod type="ITEMATTRIBUTE" ref="DICEPOOL"      value="1" mode="WIRELESS" />
		  	</modifications>
		</mode>
	</item>
