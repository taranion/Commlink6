<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<qpaths>

	<qpath id="critter_bond">
		<step id="critter_initial_bond" level="0">
			<requires>
				<datareq type="QUALITY" ref="critter_trainer" apply="CHARACTER"/>
			</requires>
			<choices>
				<choice uuid="611050a1-082d-4431-8547-6490b16ec545" type="SUBSELECT" ref="crittertype">
					<subOption id="mundane_herbivore">
						<modifications>
							<valmod type="QUALITY" ref="dependents" value="1">
								<decision choice="b22770d5-de1c-40ed-89ba-a858efa86710" value="Critter (Herbivore)"/> 
							</valmod>
						</modifications>
					</subOption>
					<subOption id="mundane_carnivore">
						<modifications>
							<valmod type="QUALITY" ref="dependents" value="2">
								<decision choice="b22770d5-de1c-40ed-89ba-a858efa86710" value="Critter (Carnivore)"/> 
							</valmod>
						</modifications>
					</subOption>
					<subOption id="awakened_emerged">
						<modifications>
							<valmod type="QUALITY" ref="dependents" value="3">
								<decision choice="b22770d5-de1c-40ed-89ba-a858efa86710" value="Critter (Awakened/Emerged)"/> 
							</valmod>
						</modifications>
					</subOption>
				</choice>
			</choices>
			<nextSteps>
				<next>critter_greater_bond</next>
			</nextSteps>
			<modifications>
				<itemmod type="QUALITY" ref="critter_initial_bond"/>
			</modifications>
		</step>
		<step id="critter_greater_bond" level="1">
			<nextSteps>
				<next>critter_improvement</next>
				<next>critter_lost</next>
				<next>critter_goodbye</next>
			</nextSteps>
			<modifications>
				<itemmod type="QUALITY" ref="critter_initial_bond" remove="true"/>
				<itemmod type="QUALITY" ref="critter_greater_bond"/>
			</modifications>
		</step>
		<step id="critter_improvement" level="2">
			<nextSteps>
				<next>critter_lost</next>
				<next>critter_goodbye</next>
			</nextSteps>
			<modifications>
				<itemmod type="QUALITY" ref="critter_improvement"/>
			</modifications>
		</step>
		<step id="critter_lost" level="3">
			<nextSteps>
				<next>critter_improvement</next>
				<next>critter_goodbye</next>
			</nextSteps>
			<modifications>
				<itemmod type="QUALITY" ref="critter_lost"/>
			</modifications>
		</step>
		<step id="critter_broken" level="3">
			<nextSteps>
				<next>critter_improvement</next>
				<next>critter_goodbye</next>
			</nextSteps>
			<modifications>
				<itemmod type="QUALITY" ref="critter_broken"/>
			</modifications>
		</step>
		<step id="critter_goodbye" level="4">
			<modifications>
				<itemmod type="QUALITY" ref="critter_goodbye"/>
			</modifications>
		</step>
	</qpath>

	<qpath id="obsession">
		<step id="obsession_consumed" level="0">
