			</modifications>
		</step>
		<step id="obsession_goal" level="2">
			<modifications>
				<itemmod type="QUALITY" ref="obsession_fulfilled" remove="true"/>
				<itemmod type="QUALITY" ref="obsession_goal"/>
			</modifications>
		</step>
		<step id="obsession_misfortune" level="3">
			<modifications>
				<itemmod type="QUALITY" ref="obsession_misfortune"/>
			</modifications>
		</step>
	</qpath>

