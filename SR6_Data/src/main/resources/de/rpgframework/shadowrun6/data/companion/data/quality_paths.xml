			</modifications>
		</step>
		<step id="obsession_fulfilled" level="1">
			<nextSteps>
				<next>obsession_obsessive</next>
				<next>obsession_goal</next>
			</nextSteps>
			<modifications>
				<itemmod type="QUALITY" ref="obsession_consumed" remove="true"/>
				<itemmod type="QUALITY" ref="obsession_fulfilled"/>
			</modifications>
		</step>
		<step id="obsession_obsessive" level="2">
			<nextSteps>
