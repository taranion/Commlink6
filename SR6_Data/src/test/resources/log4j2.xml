<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="info">
    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
             <PatternLayout   pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%c] (%F:%L) - %m%n" />
        </Console>
    </Appenders>
    <Loggers>
        <Root level="INFO" additivity="false">
            <appender-ref ref="console" />
        </Root>
        <Logger name="xml" level="WARN" />
        <Logger name="prelle.jfx" level="WARN" />
        <Logger name="rpgframework" level="WARN" />
        <Logger name="de.rpgframework.random" level="WARN"/>
        <Logger name="rpgframework.random" level="WARN"/>
        <Logger name="shadowrun.rungen" level="WARN" />
        <Logger name="de.rpgframework.genericrpg.items" level="INFO" />
        <Logger name="de.rpgframework.genericrpg.items.formula" level="WARN" />
        <Logger name="de.rpgframework.shadowrun6.proc.attr" level="INFO" />
        <Logger name="de.rpgframework.shadowrun6.items" level="WARN" />
    </Loggers>
</Configuration>